[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
CN = aws-load-balancer-webhook-service.kube-system.svc

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = aws-load-balancer-webhook-service
DNS.2 = aws-load-balancer-webhook-service.kube-system
DNS.3 = aws-load-balancer-webhook-service.kube-system.svc
